# ===== 模型渠道（全部可选；不配置则 AI 助手降级为「非生成式检索直出」，网站核心功能仍完整可用）=====
# 主渠道：智谱 GLM。官方端点为 https://open.bigmodel.cn/api/paas/v4
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_MODEL=glm-4.7-flash

# 备用渠道：DeepSeek。官方端点为 https://api.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 可选：显式第三渠道（与主渠道不同网关/模型时使用）
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=

# ===== AI 行为参数 =====
AI_MAX_TOKENS=3200
AI_TEMPERATURE=0.2
AI_TIMEOUT_MS=60000
AI_RETRIES=2
# 越界闸门：查询与语料的词汇重叠率低于该值时直接拒答（实测领域内>=0.73、领域外<=0.59）
AI_SCOPE_OVERLAP=0.62
AI_SCOPE_CONF=0.35
# 每 IP 每分钟 AI 请求上限
AI_RATE_LIMIT_PER_MIN=12

# ===== 管理端（配置后写操作才启用；长度需 >= 12，否则管理端写接口返回 501）=====
ADMIN_TOKEN=

# ===== 服务与限流 =====
PORT=8787
HOST=0.0.0.0
NODE_ENV=production
DB_PATH=
API_RATE_PER_MIN=240
FEEDBACK_RATE_PER_MIN=6
CANDIDATE_RATE_PER_MIN=6
ADMIN_RATE_PER_MIN=120